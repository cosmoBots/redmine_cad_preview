<%= render :layout => 'layouts/file' do %>
  <% format = @cad_format == 'dwg' ? 'dxf' : @cad_format %>
  <% dwg_state = RedmineCadPreview::DwgConverter.state(@attachment) if @cad_format == 'dwg' %>
  <% if @cad_format == 'inventor' %>
    <% if @cad_image %>
      <div class="cad-preview-image">
        <%= image_tag cad_preview_image_path(@attachment), :alt => @attachment.filename %>
      </div>
      <p class="cad-preview-hint"><%= l(:text_cad_preview_inventor_image) %></p>
    <% else %>
      <p class="nodata cad-preview-message"><%= l(:text_cad_preview_no_image) %></p>
    <% end %>
  <% elsif dwg_state == :converting || dwg_state == :failed %>
    <p class="<%= dwg_state == :failed ? 'nodata' : 'warning' %> cad-preview-message">
      <%= l(dwg_state == :failed ? :text_cad_preview_conversion_failed : :text_cad_preview_converting) %>
    </p>
  <% else %>
    <% url = @cad_format == 'dwg' ? cad_preview_dxf_path(@attachment) : cad_preview_file_path(@attachment) %>
    <div class="cad-preview"
         data-cad-preview
         data-url="<%= url %>"
         data-format="<%= format %>"
         data-error="<%= l(:text_cad_preview_error) %>"
         data-filename="<%= @attachment.filename %>"
         <% if @cad_snapshot %>
         data-snapshot-url="<%= cad_preview_snapshot_path(@attachment) %>"
         <% end %>
         <% if %w[step iges brep].include?(format) %>
         data-occt-script="<%= asset_path('plugin_assets/redmine_cad_preview/occt-import-js.js') %>"
         data-occt-wasm="<%= asset_path('plugin_assets/redmine_cad_preview/occt-import-js.wasm') %>"
         <% end %>
         <% if format == 'dxf' %>
         data-fonts="<%= %w[latin latin-ext].map {|s| asset_path("plugin_assets/redmine_cad_preview/noto-sans-#{s}-400-normal.woff")}.to_json %>"
         <% end %>
         data-i18n="<%= {:distance => l(:label_cad_preview_distance), :angle => l(:label_cad_preview_angle),
                         :dimensions => l(:label_cad_preview_dimensions), :units => l(:label_cad_preview_units)}.to_json %>">
      <div class="cad-preview-toolbar">
        <% icon = ->(name, label) { sprite_icon(name, label, :plugin => 'redmine_cad_preview') } %>
        <%= link_to icon.('zoom-scan', l(:button_cad_preview_fit)), '#', :class => 'icon', :data => {:cad_action => 'fit'} %>
        <% unless format == 'dxf' %>
          <%= link_to icon.('box', l(:button_cad_preview_wireframe)), '#', :class => 'icon', :data => {:cad_action => 'wireframe'} %>
        <% end %>
        <%= link_to icon.('ruler-measure', l(:button_cad_preview_measure_distance)), '#', :class => 'icon', :data => {:cad_action => 'measure-distance'} %>
        <%= link_to icon.('angle', l(:button_cad_preview_measure_angle)), '#', :class => 'icon', :data => {:cad_action => 'measure-angle'} %>
        <% %w[png pdf].each do |type| %>
          <%= link_to icon.("file-type-#{type}", type.upcase), '#', :class => 'icon', :title => "#{l(:button_download)} (#{type.upcase})",
                      :data => {:cad_action => "download-#{type}"} %>
        <% end %>
        <%= link_to icon.('arrows-maximize', l(:button_cad_preview_maximize)), '#', :class => 'icon cad-preview-maximize', :data => {:cad_action => 'maximize'} %>
        <%= link_to icon.('arrows-minimize', l(:button_cad_preview_restore)), '#', :class => 'icon cad-preview-restore', :data => {:cad_action => 'maximize'} %>
        <%= link_to icon.('maximize', l(:button_cad_preview_fullscreen)), '#', :class => 'icon cad-preview-fullscreen', :data => {:cad_action => 'fullscreen'} %>
        <%= link_to icon.('minimize', l(:button_cad_preview_exit_fullscreen)), '#', :class => 'icon cad-preview-exit-fullscreen', :data => {:cad_action => 'fullscreen'} %>
      </div>
      <div class="cad-preview-info">
        <span class="cad-preview-dimensions"></span>
        <span class="cad-preview-measurement"></span>
        <span class="cad-preview-hint"><%= l(format == 'dxf' ? :text_cad_preview_hint_2d : :text_cad_preview_hint_3d) %></span>
      </div>
      <div class="cad-preview-canvas">
        <div class="cad-preview-status"><%= l(:label_loading) %></div>
      </div>
    </div>
  <% end %>
<% end %>

<% content_for :header_tags do %>
  <%= stylesheet_link_tag 'cad_preview', :plugin => 'redmine_cad_preview' %>
  <%= javascript_include_tag 'cad_preview', :plugin => 'redmine_cad_preview', :type => 'module' %>
<% end %>
