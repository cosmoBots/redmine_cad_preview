<%# The viewer of an attachment, on the attachment page and in the macro.
    Locals: attachment, cad_format, cad_image (image saved in the file or nil),
            snapshot (true to send a snapshot for the thumbnail),
            view (name of the view restored when the viewer is loaded, or nil for the default view),
            embedded (true in the macro: compact toolbar, started when visible),
            height (height of the canvas in pixels, or nil),
            readonly (optional, true in the macro to hide the controls to save views) %>
<% format = cad_format == 'dwg' ? 'dxf' : cad_format %>
<% dwg_state = RedmineCadPreview::DwgConverter.state(attachment) if cad_format == 'dwg' %>
<% if RedmineCadPreview::IMAGE_FORMATS.include?(cad_format) %>
  <% if cad_image %>
    <div class="cad-preview-image">
      <%= image_tag cad_preview_image_path(attachment), :alt => attachment.filename %>
    </div>
    <p class="cad-preview-hint"><%= l(:"text_cad_preview_#{cad_format}_image") %></p>
  <% else %>
    <p class="nodata cad-preview-message"><%= l(:text_cad_preview_no_image) %></p>
  <% end %>
<% elsif dwg_state == :converting || dwg_state == :failed %>
  <p class="<%= dwg_state == :failed ? 'nodata' : 'warning' %> cad-preview-message">
    <%= l(dwg_state == :failed ? :text_cad_preview_conversion_failed : :text_cad_preview_converting) %>
  </p>
<% else %>
  <% url = cad_format == 'dwg' ? cad_preview_dxf_path(attachment) : cad_preview_file_path(attachment) %>
  <% viewer_options = RedmineCadPreview::ViewerOptions.for(attachment) %>
  <% views_editable = !local_assigns[:readonly] && CadPreviewView.editable?(attachment) %>
  <%# The image of the view that is restored, shown until the viewer is ready %>
  <% placeholder = (view ? RedmineCadPreview::Views.find(attachment, view) : RedmineCadPreview::Views.default(attachment))&.image %>
  <%# In the macro, the buttons show only their icon, with the label as title %>
  <% button = lambda do |icon_name, label, action, css_class: nil, plugin: 'redmine_cad_preview', **options|
       link_to sprite_icon(icon_name, label, :plugin => plugin, :icon_only => embedded), '#',
               :class => ['icon', ('icon-only' if embedded), css_class].compact.join(' '),
               :title => (label if embedded), :data => {:cad_action => action}, **options
     end %>
  <% labelled = ->(text, &block) { embedded ? capture(&block) : content_tag(:label, safe_join([text, ' ', capture(&block)])) } %>
  <div class="cad-preview<%= ' cad-preview-embedded' if embedded %>"
       data-cad-preview
       data-url="<%= url %>"
       data-format="<%= format %>"
       data-material-mode="<%= viewer_options['material_mode'] %>"
       data-lighting="<%= viewer_options['lighting'] %>"
       data-error="<%= l(:text_cad_preview_error) %>"
       data-filename="<%= attachment.filename %>"
       data-views-url="<%= cad_preview_views_path(attachment) %>"
       <% if view %>
       data-view="<%= view %>"
       <% end %>
       <% if embedded %>
       data-embedded="true"
       <% end %>
       <% if cad_image && format == 'dxf' %>
       data-image-url="<%= cad_preview_image_path(attachment) %>"
       <% end %>
       <% if snapshot %>
       data-snapshot-url="<%= cad_preview_snapshot_path(attachment) %>"
       <% end %>
       <% if RedmineCadPreview::OCCT_FORMATS.include?(format) %>
       data-occt-script="<%= asset_path('plugin_assets/redmine_cad_preview/occt-import-js.js') %>"
       data-occt-wasm="<%= asset_path('plugin_assets/redmine_cad_preview/occt-import-js.wasm') %>"
       data-occt-worker="<%= asset_path('plugin_assets/redmine_cad_preview/cad_preview_occt_worker.js') %>"
       <% end %>
       <% if format == 'dxf' %>
       data-fonts="<%= %w[latin latin-ext].map {|s| asset_path("plugin_assets/redmine_cad_preview/noto-sans-#{s}-400-normal.woff")}.to_json %>"
       data-dxf-worker="<%= asset_path('plugin_assets/redmine_cad_preview/cad_preview_dxf_worker.js') %>"
       <% end %>
       data-i18n="<%= {:distance => l(:label_cad_preview_distance), :angle => l(:label_cad_preview_angle),
                       :dimensions => l(:label_cad_preview_dimensions), :units => l(:label_cad_preview_units),
                       :solids => l(:text_cad_preview_solids),
                       :view_default => l(:label_default), :view_saved => l(:text_cad_preview_view_saved),
                       :view_deleted => l(:text_cad_preview_view_deleted), :view_stale => l(:text_cad_preview_view_stale),
                       :view_error => l(:text_cad_preview_view_error),
                       :view_name_format => l(:text_cad_preview_view_name_format),
                       :view_confirm_delete => l(:text_cad_preview_view_confirm_delete),
                       :view_not_found => l(:text_cad_preview_view_not_found),
                       :view_changed => l(:label_cad_preview_view_changed)}.to_json %>">
    <div class="cad-preview-toolbar">
      <span class="cad-preview-toolbar-group">
        <%= button.('arrows-maximize', l(:button_cad_preview_maximize), 'maximize', :css_class => 'cad-preview-maximize') %>
        <%= button.('arrows-minimize', l(:button_cad_preview_restore), 'maximize', :css_class => 'cad-preview-restore') %>
        <%= button.('maximize', l(:button_cad_preview_fullscreen), 'fullscreen', :css_class => 'cad-preview-fullscreen') %>
        <%= button.('minimize', l(:button_cad_preview_exit_fullscreen), 'fullscreen', :css_class => 'cad-preview-exit-fullscreen') %>
        <%= button.('zoom-scan', l(:button_cad_preview_fit), 'fit') %>
        <% if RedmineCadPreview::OCCT_FORMATS.include?(format) %>
          <%# Shown by the viewer if the model has more than one part %>
          <%= button.('list-tree', l(:button_cad_preview_parts), 'parts', :hidden => true) %>
        <% end %>
      </span>
      <% unless format == 'dxf' %>
        <span class="cad-preview-toolbar-group">
          <%= labelled.(l(:label_cad_preview_material_mode)) do %>
            <%= select_tag 'cad_material_mode', options_for_select(RedmineCadPreview::ViewerOptions.choices('material_mode'), viewer_options['material_mode']),
                           :id => nil, :title => l(:label_cad_preview_material_mode), :data => {:cad_material_mode => true} %>
          <% end %>
          <%= labelled.(l(:label_cad_preview_lighting)) do %>
            <%= select_tag 'cad_lighting', options_for_select(RedmineCadPreview::ViewerOptions.choices('lighting'), viewer_options['lighting']),
                           :id => nil, :title => l(:label_cad_preview_lighting), :data => {:cad_lighting => true} %>
          <% end %>
          <%= button.('box', l(:button_cad_preview_wireframe), 'wireframe') %>
          <%= button.('axis-x', l(:button_cad_preview_world_axes), 'world-axes', 'aria-pressed': 'true') %>
        </span>
      <% end %>
      <span class="cad-preview-toolbar-group">
        <%= labelled.(l(:label_cad_preview_view)) do %>
          <%= select_tag 'cad_view', '', :id => nil, :title => l(:label_cad_preview_view), :data => {:cad_view => true} %>
        <% end %>
        <% if views_editable %>
          <%= button.('save', l(:button_cad_preview_save_view), 'save-view', :plugin => nil) %>
          <%= button.('del', l(:button_cad_preview_delete_view), 'delete-view', :plugin => nil, :hidden => true) %>
        <% end %>
      </span>
      <%# The tools for measuring and cutting start a new line %>
      <span class="cad-preview-toolbar-break"></span>
      <span class="cad-preview-toolbar-group cad-preview-tools">
        <%= button.('ruler-measure', l(:button_cad_preview_measure_distance), 'measure-distance') %>
        <%= button.('angle', l(:button_cad_preview_measure_angle), 'measure-angle') %>
        <% unless format == 'dxf' %>
          <%= button.('slice', l(:button_cad_preview_section), 'section') %>
          <span class="cad-preview-section-controls" hidden>
            <%= select_tag 'cad_section_axis', options_for_select(%w[x y z].map {|axis| [axis.upcase, axis]}),
                           :id => nil, :title => l(:button_cad_preview_section), :data => {:cad_section_axis => true} %>
            <input type="range" min="0" max="1000" step="1" value="500" title="<%= l(:label_cad_preview_section_position) %>"
                   aria-label="<%= l(:label_cad_preview_section_position) %>" data-cad-section-position>
            <%= button.('arrows-exchange', l(:button_cad_preview_flip_section), 'section-flip') %>
          </span>
        <% end %>
      </span>
      <span class="cad-preview-toolbar-group cad-preview-downloads">
        <% %w[png pdf].each do |type| %>
          <%= link_to sprite_icon("file-type-#{type}", type.upcase, :plugin => 'redmine_cad_preview', :icon_only => embedded), '#',
                      :class => ['icon', ('icon-only' if embedded)].compact.join(' '),
                      :title => "#{l(:button_download)} (#{type.upcase})", :data => {:cad_action => "download-#{type}"} %>
        <% end %>
      </span>
    </div>
    <% if views_editable %>
      <form class="cad-preview-view-form" hidden>
        <label><%= l(:field_name) %>
          <%= text_field_tag 'name', '', :id => nil, :required => true, :maxlength => 64, :size => 20, :autocomplete => 'off',
                             :pattern => '[A-Za-z0-9][A-Za-z0-9_\-]{0,63}' %>
        </label>
        <label><%= check_box_tag 'is_default', '1', false, :id => nil %> <%= l(:label_default) %></label>
        <button type="submit"><%= l(:button_save) %></button>
        <button type="button" data-cad-view-cancel><%= l(:button_cancel) %></button>
      </form>
    <% end %>
    <div class="cad-preview-info">
      <span class="cad-preview-dimensions"></span>
      <span class="cad-preview-measurement"></span>
      <% unless embedded %>
        <span class="cad-preview-hint"><%= l(format == 'dxf' ? :text_cad_preview_hint_2d : :text_cad_preview_hint_3d) %></span>
      <% end %>
      <span class="cad-preview-view-status" role="status"></span>
    </div>
    <div class="cad-preview-canvas"<% if height %> style="--cad-preview-height: <%= height.to_i %>px"<% end %>>
      <% if placeholder %>
        <%= image_tag download_named_attachment_path(placeholder, placeholder.filename), :alt => '',
                      :class => "cad-preview-placeholder#{' cad-preview-placeholder-drawing' if format == 'dxf'}" %>
      <% end %>
      <% if RedmineCadPreview::OCCT_FORMATS.include?(format) %>
        <div class="cad-preview-parts" hidden>
          <div class="cad-preview-parts-header">
            <strong><%= l(:button_cad_preview_parts) %></strong>
            <button type="button" data-cad-parts-show-all><%= l(:button_cad_preview_show_all_parts) %></button>
          </div>
          <ul class="cad-preview-parts-tree"></ul>
        </div>
        <template class="cad-preview-part-template">
          <li class="cad-preview-part">
            <button type="button" class="cad-preview-part-toggle" data-cad-part-toggle title="<%= l(:label_cad_preview_toggle_part) %>">
              <span class="cad-preview-part-shown"><%= sprite_icon('eye', :plugin => 'redmine_cad_preview') %></span>
              <span class="cad-preview-part-hidden-icon"><%= sprite_icon('eye-off', :plugin => 'redmine_cad_preview') %></span>
            </button>
            <button type="button" class="cad-preview-part-name" data-cad-part-name title="<%= l(:label_cad_preview_show_only_part) %>"></button>
          </li>
        </template>
      <% end %>
      <div class="cad-preview-status"><%= l(:label_loading) %></div>
    </div>
  </div>
<% end %>
