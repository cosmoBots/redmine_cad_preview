<p>
  <label><%= l(:label_cad_preview_formats) %></label>
  <% RedmineCadPreview::FORMATS.each do |format, extensions| %>
    <label class="block">
      <%= check_box_tag 'settings[formats][]', format, RedmineCadPreview.enabled_formats.include?(format), :id => nil %>
      <%= extensions.join(', ') %>
    </label>
  <% end %>
  <%= hidden_field_tag 'settings[formats][]', '', :id => nil %>
</p>

<p>
  <%= label_tag 'settings_max_file_size', l(:label_cad_preview_max_file_size) %>
  <%= number_field_tag 'settings[max_file_size]', RedmineCadPreview.max_file_size / 1.megabyte,
                       :id => 'settings_max_file_size', :min => 1, :size => 6 %> MB
</p>

<fieldset class="box">
  <legend><%= l(:label_cad_preview_viewer_defaults) %></legend>
  <% viewer_defaults = RedmineCadPreview::ViewerOptions.defaults %>
  <p>
    <%= label_tag 'settings_material_mode', l(:label_cad_preview_material_mode) %>
    <%= select_tag 'settings[material_mode]',
                   options_for_select(RedmineCadPreview::ViewerOptions.choices('material_mode'), viewer_defaults['material_mode']),
                   :id => 'settings_material_mode' %>
  </p>
  <p>
    <%= label_tag 'settings_lighting', l(:label_cad_preview_lighting) %>
    <%= select_tag 'settings[lighting]',
                   options_for_select(RedmineCadPreview::ViewerOptions.choices('lighting'), viewer_defaults['lighting']),
                   :id => 'settings_lighting' %>
  </p>
</fieldset>

<fieldset class="box">
  <legend><%= l(:label_cad_preview_dwg) %></legend>
  <% available = RedmineCadPreview::DwgConverter.available? %>
  <table class="list">
    <tr>
      <td class="name"><%= l(:label_cad_preview_dwg2dxf_command) %>: <code><%= RedmineCadPreview::DwgConverter.command %></code></td>
      <td class="tick">
        <span class="icon-only icon-<%= available ? 'ok' : 'error' %>">
          <%= available ? sprite_icon('checked') : sprite_icon('warning') %>
        </span>
      </td>
    </tr>
  </table>
  <p>
    <% unless available %><%= l(:text_cad_preview_dwg_not_available) %><br><% end %>
    <em class="info"><code>dwg2dxf_command</code> in <code>config/configuration.yml</code></em>
  </p>
  <p>
    <%= label_tag 'settings_conversion_timeout', l(:label_cad_preview_conversion_timeout) %>
    <%= number_field_tag 'settings[conversion_timeout]', RedmineCadPreview::DwgConverter.timeout,
                         :id => 'settings_conversion_timeout', :min => 1, :size => 6 %>
    <em><%= l(:field_timeout) %></em>
  </p>
</fieldset>
